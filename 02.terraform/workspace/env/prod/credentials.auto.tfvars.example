# credentials.auto.tfvars 생성 커맨드 (컨트롤 노드에서 실행):
#
# cat > ~/terraform/env/prod/credentials.auto.tfvars << EOF
# proxmox_api_url          = "https://192.168.34.4:8006/api2/json"
# proxmox_api_token_id     = "terraform-prov@pve!terraform-token"
# proxmox_api_token_secret = "<TOKEN_SECRET>"
# ssh_public_key = [
#   "$(cat ~/.ssh/ansible-control.pub)"
# ]
# EOF

proxmox_api_url          = "https://192.168.34.4:8006/api2/json"
proxmox_api_token_id     = "terraform-prov@pve!terraform-token"
proxmox_api_token_secret = "<TOKEN_SECRET>"
ssh_public_key = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... ansible@control"
]
