global
    log /dev/log local0
    log /dev/log local1 notice
    maxconn {{ haproxy_maxconn }}
    daemon
    stats socket /var/run/haproxy.sock mode 660 level admin

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    option tcp-check
    timeout connect {{ haproxy_timeout_connect }}
    timeout client {{ haproxy_timeout_client }}
    timeout server {{ haproxy_timeout_server }}
    retries 3

frontend http_front
    bind *:80
    mode tcp
    
    acl cloudburst_active acl_file(cloudburst_active.txt)
    
    use_backend eks_http if cloudburst_active
    default_backend onprem_http

backend onprem_http
    balance roundrobin
    option tcp-check
    tcp-check connect
{% for server in onprem_servers %}
    server {{ server.name }} {{ server.ip }}:{{ server.port }} check inter 5s fall 3 rise 2 weight 100
{% endfor %}

backend eks_http
    balance roundrobin
    option tcp-check
    tcp-check connect
{% for server in eks_servers %}
    server {{ server.name }} {{ server.ip }}:{{ server.port }} check inter 5s fall 3 rise 2 weight 100 init-addr libc,none
{% endfor %}

frontend https_front
    bind *:443
    mode tcp
    
    acl cloudburst_active acl_file(cloudburst_active.txt)
    
    use_backend eks_https if cloudburst_active
    default_backend onprem_https

backend onprem_https
    balance roundrobin
    option tcp-check
    tcp-check connect
{% for server in onprem_servers_https %}
    server {{ server.name }} {{ server.ip }}:{{ server.port }} check inter 5s fall 3 rise 2 weight 100
{% endfor %}

backend eks_https
    balance roundrobin
    option tcp-check
    tcp-check connect
{% for server in eks_servers_https %}
    server {{ server.name }} {{ server.ip }}:{{ server.port }} check inter 5s fall 3 rise 2 weight 100 init-addr libc,none
{% endfor %}

listen stats
    bind *:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s
    stats admin if LOCALHOST
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_pass }}